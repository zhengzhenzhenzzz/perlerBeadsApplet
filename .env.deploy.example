# H5 部署配置模板
#
# 用法：复制为 .env.deploy 并填写实际值
#   cp .env.deploy.example .env.deploy
#
# .env.deploy 含服务器地址等敏感信息，已在 .gitignore 中忽略，切勿提交。
# CI 环境可直接注入同名环境变量（优先级高于本文件），无需落盘。

# ---- 必填 ----

# 服务器地址：IP 或主机名
DEPLOY_HOST=

# SSH 登录用户名
DEPLOY_USER=

# 服务器上的站点根目录（绝对路径，部署时会被整体替换）
DEPLOY_WEBROOT=/var/www/yoursite

# 站点域名，用于部署后的线上验证（不带 https:// 前缀）
DEPLOY_DOMAIN=

# ---- 选填 ----

# SSH 私钥路径，支持 ~ 开头。留空则使用 ssh 默认身份（~/.ssh/id_* 或 ssh-agent）
DEPLOY_SSH_KEY=

# SSH 端口，默认 22
DEPLOY_PORT=22

# 服务器上的备份存放目录
DEPLOY_BACKUP_DIR=~/deploy_backups

# 备份文件名前缀。留空则取 DEPLOY_WEBROOT 的末段目录名
DEPLOY_BACKUP_PREFIX=

# 保留的历史备份份数，超出的自动删除
DEPLOY_KEEP_BACKUPS=5

# SPA 深链接探测路径，用于验证 nginx try_files 回退是否生效
DEPLOY_SPA_PROBE=/pages/editor/index

# 设为 1 时日志输出明文地址（默认脱敏，避免 CI 日志或截图泄露）
DEPLOY_SHOW_SECRETS=
